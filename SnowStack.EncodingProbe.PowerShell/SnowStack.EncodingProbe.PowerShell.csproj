<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <LangVersion>latest</LangVersion>


      <!-- バージョン情報 -->
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>

    <!-- NuGet パッケージメタデータ -->
    <PackageId>SnowStack.EncodingProbe.PowerShell</PackageId>
    <Authors>motoi.tsushima</Authors>
    <Description>A PowerShell module for detecting the character encoding of text files.
テキストファイルの文字エンコーディングを判定する PowerShell モジュールです。</Description>
    <PackageTags>encoding;chardet;text;powershell</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Configurations>Debug;Release;PS5.1_Debug;PS7.x_Debug</Configurations>
  </PropertyGroup>
    
  <ItemGroup>
    <PackageReference Include="PowerShellStandard.Library" Version="5.1.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SnowStack.EncodingProbe\SnowStack.EncodingProbe.csproj" />
  </ItemGroup>

  <!--
    MAML ヘルプ。Get-Help はアセンブリと同じ場所のカルチャー別フォルダーを探す。
    対応言語は、判定処理が対象としている言語圏に合わせた 5 言語。
    フォルダー名は Windows が報告する UI カルチャー名そのものにする
    （zh-Hant / zh-Hans のような親カルチャー名は使わない）。
    zh-HK（香港）は今回未対応であり、en-US へフォールバックさせる。
  -->
  <ItemGroup>
    <Content Include="en-US\SnowStack.EncodingProbe.PowerShell.dll-Help.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ja-JP\SnowStack.EncodingProbe.PowerShell.dll-Help.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ko-KR\SnowStack.EncodingProbe.PowerShell.dll-Help.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="zh-TW\SnowStack.EncodingProbe.PowerShell.dll-Help.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="zh-CN\SnowStack.EncodingProbe.PowerShell.dll-Help.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- EncodingSpec 等の internal 実装をテストプロジェクトからのみ参照可能にする -->
  <ItemGroup>
    <InternalsVisibleTo Include="EncodingProbe.PowerShell.Tests" />
  </ItemGroup>

</Project>
