<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- TargetFramework(単数) → TargetFrameworks(複数) -->
        <TargetFrameworks>net10.0;net48</TargetFrameworks>
        <IsAotCompatible Condition="'$(TargetFramework)' == 'net10.0'">true</IsAotCompatible>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <!-- バージョン情報 -->
        <Version>1.1.0</Version>
        <AssemblyVersion>1.1.0.0</AssemblyVersion>
        <FileVersion>1.1.0.0</FileVersion>

        <!-- NuGet パッケージメタデータ -->
        <PackageId>SnowStack.EncodingProbe</PackageId>
        <Authors>motoi.tsushima</Authors>
        <Company>motoi.tsushima</Company>
        <Description>
            A class library for detecting the character encoding of text files.
            テキストファイルの文字エンコーディングを判定するクラスライブラリです。
        </Description>
        <PackageTags>encoding;chardet;charset;text;shift-jis;euc-jp;japanese</PackageTags>
        <Copyright>Copyright © 2026 motoi.tsushima</Copyright>

        <!-- ライセンス / URL（README に表示される） -->
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/motoi-tsushima/SnowStack.EncodingProbe</PackageProjectUrl>
        <RepositoryUrl>https://github.com/motoi-tsushima/SnowStack.EncodingProbe</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>初回リリース。文字エンコーディング推測 / BOM / 改行コード判定に対応。</PackageReleaseNotes>

        <!-- パッケージ生成は dotnet pack で明示的に行う -->
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

        <!-- デバッグ容易性: シンボル + SourceLink -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
        <Configurations>Debug;Release;PS5.1_Debug;PS7.x_Debug</Configurations>
    </PropertyGroup>

    <ItemGroup>
        <!-- SourceLink: NuGet.org のシンボルから GitHub のソースへ飛べる -->
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" />
    </ItemGroup>

    <!--
      UTF.Unknown は TFM ごとにバージョンを分ける。
      2.7.0 は netstandard2.0 アセットが System.Memory に依存するため、
      .NET Framework では厳密名の完全一致解決に阻まれ、
      app.config を差し込めない PowerShell 5.1 ホストで読み込みに失敗する。
      net48 では ReadOnlySpan API を使っておらず判定結果も同一のため 2.6.0 に据え置く。
    -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="UTF.Unknown" Version="2.7.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
        <PackageReference Include="UTF.Unknown" Version="2.6.0" />
        <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    </ItemGroup>

    <!-- PlatformInfoResolver 等の internal 実装を PowerShell 層からのみ参照可能にする -->
    <ItemGroup>
        <InternalsVisibleTo Include="SnowStack.EncodingProbe.PowerShell" />
        <!-- カルチャーゲート（EncodingDetector.ResolveEastAsianLegacyRegion）の単体テスト用 -->
        <InternalsVisibleTo Include="EncodingProbe.Tests" />
    </ItemGroup>

    <!-- リポジトリ直下の README.md をパッケージに同梱 -->
    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

</Project>